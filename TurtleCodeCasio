//code:
A = 1 //index
Repeat 5 times:
    if A = 1 then: // body values
        B = -35 //x
        C = -2  //y
        D = -90 //angle
        E = 1   //size multiplicator
    if A = 2 then: // back left leg values
        B = 35
        C = 10
        D = 70
    if A = 3 then: // front left leg values
        B = -35
        C = -10
        D = 105
    if A = 4 then: // front right leg values
        B = 35
        C = -10
        D = 105
    if A = 5 then: // back right leg values
        B = -35
        C = 10
        D = 75
        E = 0.5
    pen up
    go to x = B;y = C;
    look at D°
    pen down
    repeat 2 times: // do a rectancle with rounded corners
        repeat 5 times:
            go fordward 1 pixel
            turn left 18°
        repeat 25 times:
            go fordward 2*E pixel
        repeat 5 times:
            go fordward 1 pixel
            turn left 18°
        go fordward 5 pixel
    A = A + 1 // increment index
pen up        // head
go to x = 40;y = 0;
look at -90°
pen down
repeat 72 times: // do a circle
    go fordward 1 pixel
    turn left 5 °
pen up // prevent an line drawing when going out of bounds
go to x = 50;y = 50; // go out of bounds
